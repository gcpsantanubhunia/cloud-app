@cloud_app_HostAddress = http://localhost:5299

###
GET {{cloud_app_HostAddress}}/
Accept: application/json
###
GET {{cloud_app_HostAddress}}/books/
Accept: application/json
###

@id=1
GET {{cloud_app_HostAddress}}/books/{{id}}
Accept: application/json
###

POST {{cloud_app_HostAddress}}/books
Content-Type: application/json

{
  "bookName": "The Pragmatic Programmer",
  "Price": 49.99,
  "Category": "Computers",
  "Author": "Santanu Bhunia"
}
 
###
@putid=1
PUT {{cloud_app_HostAddress}}/books/{{putid}}
Content-Type: application/json

{
  "bookName": "OOPS Concepts",
  "Price": 45.00,
  "Category": "Computers",
  "Author": "Santanu Bhunia"
}
###
@deleteid=1
DELETE {{cloud_app_HostAddress}}/Books/{{deleteid}}